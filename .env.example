NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# API de paquetes que usa la interfaz: "simulated" (por defecto, hasta DECOR-27) o "live".
# Se fija al construir la aplicación: hay que reconstruir tras cambiarla.
NEXT_PUBLIC_DECOR_PACKAGES_API=simulated
SUPABASE_SERVICE_ROLE_KEY=
CLOUDINARY_URL=
# Secreto Bearer para /api/internal/recovery (DECOR-31). Sin configurar, el endpoint responde 503.
DECOR_RECOVERY_SECRET=
DECOR_E2E_EMAIL=
DECOR_E2E_PASSWORD=
DECOR_E2E_ALLOW_SIGNUP=
DECOR_E2E_BASE_URL=
# E2E móvil del MVP (DECOR-39): cuentas dedicadas que crea/reajusta `npm run e2e:seed`.
# No reutilices DECOR_E2E_EMAIL: el logout de auth.spec.ts revocaría su sesión.
DECOR_E2E_USER_A_EMAIL=
DECOR_E2E_USER_A_PASSWORD=
DECOR_E2E_USER_B_EMAIL=
DECOR_E2E_USER_B_PASSWORD=
