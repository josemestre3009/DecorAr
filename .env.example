NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# API de paquetes que usa la interfaz: "simulated" (por defecto, hasta DECOR-27) o "live".
# Se fija al construir la aplicación: hay que reconstruir tras cambiarla.
NEXT_PUBLIC_DECOR_PACKAGES_API=simulated
SUPABASE_SERVICE_ROLE_KEY=
CLOUDINARY_URL=
# Secreto Bearer para /api/internal/recovery (DECOR-31). Sin configurar, el endpoint responde 503.
DECOR_RECOVERY_SECRET=
DECOR_E2E_EMAIL=
DECOR_E2E_PASSWORD=
DECOR_E2E_ALLOW_SIGNUP=
DECOR_E2E_BASE_URL=
