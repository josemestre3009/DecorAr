  "cards": [
    { "dot": "rose", "title": "Seguridad", "items": ["Route Handlers verifican identidad y propietario; RLS añade una segunda barrera.", "Enlaces públicos guardan hash, no token; expiran y pueden revocarse. Token inválido, vencido, revocado o no compartible produce el mismo 404.", "service_role y secreto HMAC permanecen server-side; enlaces llevan no-store y no-referrer."] },
    { "dot": "cyan", "title": "Capacidades actuales", "items": ["Cotizaciones: versiones inmutables, estados draft/sent/accepted/expired y PDF basado en el snapshot guardado.", "Plantillas privadas se instancian como paquete propio tras autorización.", "Escena guarda transforms con versión propia: no cambia packages.version ni recalcula presupuesto."] },
    { "dot": "emerald", "title": "Infraestructura y lectura", "items": ["Compose ejecuta sólo app; PostgreSQL, Auth y Realtime son Supabase alojado; Cloudinary sirve activos 3D.", "DecorAR es monolito modular desplegado junto, no microservicios.", "Route Handlers se agrupan por capacidad; se omite el inventario ruta-por-ruta. Health, sesión y catálogo siguen disponibles como endpoints."] }
